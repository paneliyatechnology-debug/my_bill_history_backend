  fileSizeBytes         Int              @map("file_size_bytes")
  fileStoragePath       String           @map("file_storage_path") @db.VarChar(500)
  fileSha256            String           @map("file_sha256") @db.VarChar(64)
  status                ScanStatus       @default(PENDING)
  ocrProvider           String           @default("mock") @map("ocr_provider") @db.VarChar(50)
  extractedData         Json?            @map("extracted_data")
  rawOcrText            String?          @map("raw_ocr_text") @db.Text
  matchedPartyId        String?          @map("matched_party_id") @db.Uuid
  matchedPartyScore     Decimal?         @map("matched_party_score") @db.Decimal(5, 2)
  purchaseInvoiceId     String?          @unique @map("purchase_invoice_id") @db.Uuid
  errorMessage          String?          @map("error_message") @db.Text
  idempotencyKey        String?          @map("idempotency_key") @db.VarChar(100)
  createdById           String?          @map("created_by_id") @db.Uuid
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  company               Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch                Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  matchedParty          Party?           @relation(fields: [matchedPartyId], references: [id], onDelete: SetNull)
  purchaseInvoice       PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id], onDelete: SetNull)

  @@index([organizationId, companyId, status])
  @@index([companyId, fileSha256])
  @@unique([companyId, idempotencyKey])
  @@map("purchase_bill_scans")
}

