  bomInputs           BomItem[]
  stockTransferItems  StockTransferItem[]
  deliveryChallanItems DeliveryChallanItem[]

  @@unique([companyId, sku])
  @@index([organizationId, companyId])
  @@index([barcode])
  @@index([hsnCode])
  @@index([hsnMasterId])
