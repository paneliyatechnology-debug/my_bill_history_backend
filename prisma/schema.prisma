enum StockTransferStatus {
  DRAFT
  DISPATCHED
  RECEIVED
  CANCELLED
}

model StockTransfer {
  id              String              @id @default(uuid()) @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  companyId       String              @map("company_id") @db.Uuid
  branchId        String              @map("branch_id") @db.Uuid
  financialYearId String              @map("financial_year_id") @db.Uuid
  transferNumber  String              @map("transfer_number") @db.VarChar(100)
  transferDate    DateTime            @map("transfer_date") @db.Date
  fromWarehouseId String              @map("from_warehouse_id") @db.Uuid
  toWarehouseId   String              @map("to_warehouse_id") @db.Uuid
  status          StockTransferStatus @default(DRAFT) @map("status")
  challanNumber   String?             @map("challan_number") @db.VarChar(100)
  dispatchedAt    DateTime?           @map("dispatched_at")
  receivedAt      DateTime?           @map("received_at")
  dispatchedBy    String?             @map("dispatched_by") @db.Uuid
  receivedBy      String?             @map("received_by") @db.Uuid
  notes           String?             @db.Text
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch          Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  financialYear   FinancialYear       @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  fromWarehouse   Warehouse           @relation("StockTransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouse     Warehouse           @relation("StockTransferTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  items           StockTransferItem[]

  @@unique([companyId, transferNumber])
  @@index([organizationId, companyId, transferDate])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@map("stock_transfers")
}

model StockTransferItem {
  id               String        @id @default(uuid()) @db.Uuid
  transferId       String        @map("transfer_id") @db.Uuid
  itemId           String        @map("item_id") @db.Uuid
  batchId          String?       @map("batch_id") @db.Uuid
  quantity         Decimal       @map("quantity") @db.Decimal(15, 4)
  receivedQuantity Decimal?      @map("received_quantity") @db.Decimal(15, 4)
  unitCost         Decimal       @default(0.00) @map("unit_cost") @db.Decimal(15, 4)
  totalCost        Decimal       @default(0.00) @map("total_cost") @db.Decimal(15, 2)

  transfer         StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item             Item          @relation(fields: [itemId], references: [id], onDelete: Restrict)
  batch            ItemBatch?    @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([transferId])
  @@index([itemId])
  @@map("stock_transfer_items")
}

enum DeliveryChallanType {
  JOB_WORK
  SUPPLY_ON_APPROVAL
  BRANCH_TRANSFER
  OTHER
}

enum DeliveryChallanStatus {
  DRAFT
  ISSUED
  CLOSED
  CANCELLED
}

model DeliveryChallan {
  id                 String                @id @default(uuid()) @db.Uuid
  organizationId     String                @map("organization_id") @db.Uuid
  companyId          String                @map("company_id") @db.Uuid
  branchId           String                @map("branch_id") @db.Uuid
  financialYearId    String                @map("financial_year_id") @db.Uuid
  partyId            String?               @map("party_id") @db.Uuid
  warehouseId        String                @map("warehouse_id") @db.Uuid
  challanNumber      String                @map("challan_number") @db.VarChar(100)
  challanDate        DateTime              @map("challan_date") @db.Date
  challanType        DeliveryChallanType   @default(JOB_WORK) @map("challan_type")
  status             DeliveryChallanStatus @default(ISSUED) @map("status")
  eWayBillNumber     String?               @map("eway_bill_number") @db.VarChar(50)
  placeOfSupply      String?               @map("place_of_supply") @db.VarChar(50)
  taxableAmount      Decimal               @default(0.00) @map("taxable_amount") @db.Decimal(15, 2)
  cgstAmount         Decimal               @default(0.00) @map("cgst_amount") @db.Decimal(15, 2)
  sgstAmount         Decimal               @default(0.00) @map("sgst_amount") @db.Decimal(15, 2)
  igstAmount         Decimal               @default(0.00) @map("igst_amount") @db.Decimal(15, 2)
  totalAmount        Decimal               @default(0.00) @map("total_amount") @db.Decimal(15, 2)
  convertedInvoiceId String?               @map("converted_invoice_id") @db.Uuid
  notes              String?               @db.Text
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  company            Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch             Branch                @relation(fields: [branchId], references: [id], onDelete: Restrict)
  financialYear      FinancialYear         @relation(fields: [financialYearId], references: [id], onDelete: Restrict)
  party              Party?                @relation(fields: [partyId], references: [id], onDelete: Restrict)
  warehouse          Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items              DeliveryChallanItem[]
  eWayBillRecord     EWayBillRecord?

  @@unique([companyId, challanNumber])
  @@index([organizationId, companyId, challanDate])
  @@index([partyId])
  @@index([warehouseId])
  @@map("delivery_challans")
}

model DeliveryChallanItem {
  id            String          @id @default(uuid()) @db.Uuid
  challanId     String          @map("challan_id") @db.Uuid
  itemId        String          @map("item_id") @db.Uuid
  batchId       String?         @map("batch_id") @db.Uuid
  description   String?         @db.VarChar(255)
  hsnCode       String?         @map("hsn_code") @db.VarChar(20)
  quantity      Decimal         @map("quantity") @db.Decimal(15, 4)
  unitPrice     Decimal         @map("unit_price") @db.Decimal(15, 4)
  taxableAmount Decimal         @map("taxable_amount") @db.Decimal(15, 2)
  taxRate       Decimal         @default(0.00) @map("tax_rate") @db.Decimal(5, 2)
  cgstAmount    Decimal         @default(0.00) @map("cgst_amount") @db.Decimal(15, 2)
  sgstAmount    Decimal         @default(0.00) @map("sgst_amount") @db.Decimal(15, 2)
  igstAmount    Decimal         @default(0.00) @map("igst_amount") @db.Decimal(15, 2)
  totalAmount   Decimal         @map("total_amount") @db.Decimal(15, 2)

  challan       DeliveryChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  item          Item            @relation(fields: [itemId], references: [id], onDelete: Restrict)
  batch         ItemBatch?      @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([challanId])
  @@index([itemId])
  @@map("delivery_challan_items")
}

// ---------------------------------------------------------
// 10. GST COMPLIANCE: GSTR-2B, ITC REVIEW, PORTAL AUDIT
// ---------------------------------------------------------

enum GstRuntimeEnvironment {
  SANDBOX
  PRODUCTION
}

enum Gstr2bDocumentType {
  INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
}

enum Gstr2bMatchStatus {
  MATCHED
  PARTIAL_MATCH
  MISSING_IN_BOOKS
  MISSING_IN_GSTR2B
  DUPLICATE
  MISMATCH
}

enum ItcReviewDecision {
  UNREVIEWED
  ACCEPTED
  REJECTED
  DEFERRED
}

model GstIntegrationConfig {
  id                 String                 @id @default(uuid()) @db.Uuid
  organizationId     String                 @map("organization_id") @db.Uuid
  companyId          String                 @unique @map("company_id") @db.Uuid
  environment        GstRuntimeEnvironment  @default(SANDBOX)
  productionEnabled  Boolean                @default(false) @map("production_enabled")
  einvoiceClientId   String?                @map("einvoice_client_id") @db.VarChar(100)
  einvoiceUsername   String?                @map("einvoice_username") @db.VarChar(100)
  ewayClientId       String?                @map("eway_client_id") @db.VarChar(100)
  ewayUsername       String?                @map("eway_username") @db.VarChar(100)
  einvoiceSecretCiphertext String?          @map("einvoice_secret_ciphertext") @db.Text
  einvoicePasswordCiphertext String?        @map("einvoice_password_ciphertext") @db.Text
  ewaySecretCiphertext String?              @map("eway_secret_ciphertext") @db.Text
  ewayPasswordCiphertext String?            @map("eway_password_ciphertext") @db.Text
  secretKeyId        String?                @map("secret_key_id") @db.VarChar(40)
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  company            Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([organizationId, companyId])
  @@map("gst_integration_configs")
}

model Gstr2bImport {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  companyId        String       @map("company_id") @db.Uuid
  returnPeriod     String       @map("return_period") @db.VarChar(6)
  sourceFileName   String       @map("source_file_name") @db.VarChar(255)
  sourceSha256     String       @map("source_sha256") @db.VarChar(64)
  recipientGstin   String       @map("recipient_gstin") @db.VarChar(15)
  warnings         Json?
  importedById     String?      @map("imported_by_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")

  company          Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines            Gstr2bLine[]

  @@unique([companyId, sourceSha256])
  @@index([organizationId, companyId, returnPeriod])
  @@map("gstr2b_imports")
}

model Gstr2bLine {
  id                       String              @id @default(uuid()) @db.Uuid
  importId                 String              @map("import_id") @db.Uuid
  organizationId           String              @map("organization_id") @db.Uuid
  companyId                String              @map("company_id") @db.Uuid
  supplierGstin            String              @map("supplier_gstin") @db.VarChar(15)
  supplierName             String              @default("") @map("supplier_name") @db.VarChar(200)
  documentType             Gstr2bDocumentType  @map("document_type")
  invoiceNumber            String              @map("invoice_number") @db.VarChar(100)
  normalizedInvoiceNumber  String              @map("normalized_invoice_number") @db.VarChar(100)
  invoiceDate              DateTime            @map("invoice_date") @db.Date
  taxableValue             Decimal             @map("taxable_value") @db.Decimal(15, 2)
  cgstAmount               Decimal             @default(0.00) @map("cgst_amount") @db.Decimal(15, 2)
  sgstAmount               Decimal             @default(0.00) @map("sgst_amount") @db.Decimal(15, 2)
  igstAmount               Decimal             @default(0.00) @map("igst_amount") @db.Decimal(15, 2)
  cessAmount               Decimal             @default(0.00) @map("cess_amount") @db.Decimal(15, 2)
  invoiceValue             Decimal             @map("invoice_value") @db.Decimal(15, 2)
  portalItcFlag            String?             @map("portal_itc_flag") @db.VarChar(20)
  sourceSection            String              @map("source_section") @db.VarChar(20)

  import                   Gstr2bImport        @relation(fields: [importId], references: [id], onDelete: Cascade)
  company                  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reconciliations          Gstr2bReconciliation[]

  @@index([organizationId, companyId, invoiceDate])
  @@index([companyId, supplierGstin, normalizedInvoiceNumber])
  @@map("gstr2b_lines")
}

model Gstr2bReconciliation {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @map("organization_id") @db.Uuid
  companyId          String              @map("company_id") @db.Uuid
  returnPeriod       String              @map("return_period") @db.VarChar(6)
  matchKey           String              @map("match_key") @db.VarChar(220)
  purchaseInvoiceId  String?             @map("purchase_invoice_id") @db.Uuid
  purchaseReturnId   String?             @map("purchase_return_id") @db.Uuid
  gstr2bLineId       String?             @map("gstr2b_line_id") @db.Uuid
  systemStatus       Gstr2bMatchStatus   @map("system_status")
  status             Gstr2bMatchStatus
  userOverridden     Boolean             @default(false) @map("user_overridden")
  itcDecision        ItcReviewDecision   @default(UNREVIEWED) @map("itc_decision")
  explanation        Json
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseInvoice    PurchaseInvoice?    @relation(fields: [purchaseInvoiceId], references: [id], onDelete: SetNull)
  purchaseReturn     PurchaseReturn?     @relation(fields: [purchaseReturnId], references: [id], onDelete: SetNull)
  gstr2bLine         Gstr2bLine?         @relation(fields: [gstr2bLineId], references: [id], onDelete: SetNull)
  adjustments        Gstr2bAdjustment[]

  @@unique([companyId, returnPeriod, matchKey])
  @@index([organizationId, companyId, returnPeriod, status])
  @@map("gstr2b_reconciliations")
}

model Gstr2bAdjustment {
  id                 String             @id @default(uuid()) @db.Uuid
  reconciliationId   String             @map("reconciliation_id") @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  companyId          String             @map("company_id") @db.Uuid
  userId             String?            @map("user_id") @db.Uuid
  previousStatus     String             @map("previous_status") @db.VarChar(40)
  newStatus          String             @map("new_status") @db.VarChar(40)
  previousDecision   String             @map("previous_decision") @db.VarChar(40)
  newDecision        String             @map("new_decision") @db.VarChar(40)
  reason             String             @db.Text
  createdAt          DateTime           @default(now()) @map("created_at")

  reconciliation     Gstr2bReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([reconciliationId, createdAt])
  @@index([organizationId, companyId])
  @@map("gstr2b_adjustments")
}

model GstApiAuditLog {
  id                     String    @id @default(uuid()) @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  companyId              String    @map("company_id") @db.Uuid
  operation              String    @db.VarChar(60)
  environment            String    @db.VarChar(20)
  idempotencyKey         String    @map("idempotency_key") @db.VarChar(120)
  requestHash            String    @map("request_hash") @db.VarChar(64)
  outcome                String    @db.VarChar(40)
  errorCode              String?   @map("error_code") @db.VarChar(60)
  errorMessage           String?   @map("error_message") @db.Text
  externalDocumentNumber String?   @map("external_document_number") @db.VarChar(80)
  documentId             String?   @map("document_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  company                Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, operation, idempotencyKey])
  @@index([organizationId, companyId, createdAt])
  @@map("gst_api_audit_logs")
}

model OutwardDebitNote {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  branchId         String    @map("branch_id") @db.Uuid
  financialYearId  String    @map("financial_year_id") @db.Uuid
  salesInvoiceId   String    @map("sales_invoice_id") @db.Uuid
  partyId          String    @map("party_id") @db.Uuid
  voucherId        String?   @map("voucher_id") @db.Uuid
  noteNumber       String    @map("note_number") @db.VarChar(100)
  noteDate         DateTime  @map("note_date") @db.Date
  placeOfSupply    String    @map("place_of_supply") @db.Char(2)
  taxableAmount    Decimal   @map("taxable_amount") @db.Decimal(15, 2)
  cgstAmount       Decimal   @default(0.00) @map("cgst_amount") @db.Decimal(15, 2)
  sgstAmount       Decimal   @default(0.00) @map("sgst_amount") @db.Decimal(15, 2)
  utgstAmount      Decimal   @default(0.00) @map("utgst_amount") @db.Decimal(15, 2)
  igstAmount       Decimal   @default(0.00) @map("igst_amount") @db.Decimal(15, 2)
  grandTotal       Decimal   @map("grand_total") @db.Decimal(15, 2)
  reason           String    @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")

  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  salesInvoice     SalesInvoice @relation(fields: [salesInvoiceId], references: [id], onDelete: Restrict)
  party            Party     @relation(fields: [partyId], references: [id], onDelete: Restrict)
  items            OutwardDebitNoteItem[]

  @@unique([companyId, noteNumber])
  @@index([organizationId, companyId, noteDate])
  @@map("outward_debit_notes")
}

model OutwardDebitNoteItem {
  id              String           @id @default(uuid()) @db.Uuid
  noteId          String           @map("note_id") @db.Uuid
  itemId          String           @map("item_id") @db.Uuid
  hsnCode         String           @map("hsn_code") @db.VarChar(10)
  quantity        Decimal          @db.Decimal(15, 4)
  taxableAmount   Decimal          @map("taxable_amount") @db.Decimal(15, 2)
  taxRate         Decimal          @map("tax_rate") @db.Decimal(5, 2)
  cgstAmount      Decimal          @default(0.00) @map("cgst_amount") @db.Decimal(15, 2)
  sgstAmount      Decimal          @default(0.00) @map("sgst_amount") @db.Decimal(15, 2)
  utgstAmount     Decimal          @default(0.00) @map("utgst_amount") @db.Decimal(15, 2)
  igstAmount      Decimal          @default(0.00) @map("igst_amount") @db.Decimal(15, 2)
  totalAmount     Decimal          @map("total_amount") @db.Decimal(15, 2)
  supplyCategory  SupplyCategory   @default(TAXABLE) @map("supply_category")

  note            OutwardDebitNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  item            Item             @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([noteId])
  @@map("outward_debit_note_items")
}

model AdvanceReceipt {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  companyId        String            @map("company_id") @db.Uuid
  branchId         String            @map("branch_id") @db.Uuid
  financialYearId  String            @map("financial_year_id") @db.Uuid
  partyId          String            @map("party_id") @db.Uuid
  receiptNumber    String            @map("receipt_number") @db.VarChar(100)
  receiptDate      DateTime          @map("receipt_date") @db.Date
  supplyKind       AdvanceSupplyKind @map("supply_kind")
  placeOfSupply    String            @map("place_of_supply") @db.Char(2)
  taxableAmount    Decimal           @map("taxable_amount") @db.Decimal(15, 2)
  cgstAmount       Decimal           @default(0.00) @map("cgst_amount") @db.Decimal(15, 2)
  sgstAmount       Decimal           @default(0.00) @map("sgst_amount") @db.Decimal(15, 2)
  utgstAmount      Decimal           @default(0.00) @map("utgst_amount") @db.Decimal(15, 2)
  igstAmount       Decimal           @default(0.00) @map("igst_amount") @db.Decimal(15, 2)
  grandTotal       Decimal           @map("grand_total") @db.Decimal(15, 2)
  adjustedTaxable  Decimal           @default(0.00) @map("adjusted_taxable") @db.Decimal(15, 2)
  accountingPosting String           @default("NOT_POSTED_PENDING_CA") @map("accounting_posting") @db.VarChar(40)
  statutoryNote    String            @map("statutory_note") @db.Text
  createdAt        DateTime          @default(now()) @map("created_at")

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party            Party             @relation(fields: [partyId], references: [id], onDelete: Restrict)
  adjustments      AdvanceAdjustment[]

  @@unique([companyId, receiptNumber])
  @@index([organizationId, companyId, receiptDate])
  @@map("advance_receipts")
}

model AdvanceAdjustment {
  id              String         @id @default(uuid()) @db.Uuid
  advanceId       String         @map("advance_id") @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  salesInvoiceId  String?        @map("sales_invoice_id") @db.Uuid
  adjustmentDate  DateTime       @map("adjustment_date") @db.Date
  taxableAmount   Decimal        @map("taxable_amount") @db.Decimal(15, 2)
  cgstAmount      Decimal        @default(0.00) @map("cgst_amount") @db.Decimal(15, 2)
  sgstAmount      Decimal        @default(0.00) @map("sgst_amount") @db.Decimal(15, 2)
  utgstAmount     Decimal        @default(0.00) @map("utgst_amount") @db.Decimal(15, 2)
  igstAmount      Decimal        @default(0.00) @map("igst_amount") @db.Decimal(15, 2)
  reason          String         @db.Text
  createdAt       DateTime       @default(now()) @map("created_at")

  advance         AdvanceReceipt @relation(fields: [advanceId], references: [id], onDelete: Cascade)

  @@index([companyId, adjustmentDate])
  @@map("advance_adjustments")
}

model SupportSession {
  id                   String    @id @db.VarChar(64)
  actorId              String    @map("actor_id") @db.Uuid
  targetOrganizationId String    @map("target_organization_id") @db.Uuid
  targetCompanyId      String    @map("target_company_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz
  revokedAt            DateTime? @map("revoked_at") @db.Timestamptz
  isRevoked            Boolean   @default(false) @map("is_revoked")
  reason               String?   @db.Text

  @@index([id, isRevoked, expiresAt], map: "idx_support_sessions_lookup")
  @@index([actorId, isRevoked], map: "idx_support_sessions_actor")
  @@index([targetCompanyId, isRevoked], map: "idx_support_sessions_comp")
  @@map("support_sessions")
}

model EmailOtp {
  id         String    @id @default(uuid()) @db.Uuid
  email      String    @db.VarChar(150)
  purpose    String    @db.VarChar(32)
  codeHash   String    @map("code_hash") @db.VarChar(128)
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([email, purpose, createdAt])
  @@map("email_otps")
}

// ---------------------------------------------------------
// 12. DATA IMPORT SYSTEM (EXCEL / CSV IMPORT JOBS)
// ---------------------------------------------------------

enum DbImportStatus {
  PENDING
  PARSING
  VALIDATING
  CONFIRMED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum DbImportMode {
  CREATE_ONLY
  SKIP_DUPLICATES
  UPDATE_EXISTING
}

model ImportJob {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  userId          String?        @map("user_id") @db.Uuid
  module          String         @db.VarChar(50)
  fileName        String         @map("file_name") @db.VarChar(255)
  fileSize        Int            @map("file_size")
  fileFormat      String         @map("file_format") @db.VarChar(20)
  worksheetName   String?        @map("worksheet_name") @db.VarChar(100)
  status          DbImportStatus @default(PENDING)
  mode            DbImportMode   @default(SKIP_DUPLICATES)
  errorPolicy     String         @default("IMPORT_VALID_ONLY") @map("error_policy") @db.VarChar(30)
  totalRows       Int            @default(0) @map("total_rows")
  validRows       Int            @default(0) @map("valid_rows")
  importedRows    Int            @default(0) @map("imported_rows")
  updatedRows     Int            @default(0) @map("updated_rows")
  skippedRows     Int            @default(0) @map("skipped_rows")
  failedRows      Int            @default(0) @map("failed_rows")
  columnMapping   Json?          @map("column_mapping")
  errorsJson      Json?          @map("errors_json")
  summaryJson     Json?          @map("summary_json")
  errorMessage    String?        @map("error_message") @db.Text
  idempotencyKey  String?        @map("idempotency_key") @db.VarChar(100)
  startedAt       DateTime?      @map("started_at")
  completedAt     DateTime?      @map("completed_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([organizationId, companyId, createdAt])
  @@index([companyId, module])
  @@index([idempotencyKey])
  @@map("import_jobs")
}
