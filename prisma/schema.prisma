  companyId      String          @map("company_id") @db.Uuid
  finishedItemId String          @map("finished_item_id") @db.Uuid
  bomName        String          @map("bom_name") @db.VarChar(150)
  batchYieldQty  Decimal         @map("batch_yield_qty") @db.Decimal(15, 4)
