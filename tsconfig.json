{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "declarationMap": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@billing/database": ["./src/database"],
      "@billing/shared-types": ["./src/shared-types"],
      "@billing/accounting-core": ["./src/accounting-core"],
      "@billing/gst-provider": ["./src/gst-provider"]
    },
    "incremental": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "test/**/*"]
}
